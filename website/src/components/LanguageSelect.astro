---
import { Icon } from '@astrojs/starlight/components';
import { localizedUrl } from '../../node_modules/@astrojs/starlight/utils/localizedUrl';
import context from 'virtual:starlight/project-context';
import config from 'virtual:starlight/user-config';

/*
 * Starlight's own language picker is a native `<select>`. `appearance: none`
 * styles the closed box and nothing else — the open list is drawn by the
 * operating system, so it arrives as grey OS chrome floating over the header
 * and no CSS in this repo can reach it. Replacing the control is the only way
 * to style the open state at all.
 *
 * Every option here is a real `<a href>` rather than a button with a `change`
 * handler, and that — not the styling — is the reason this override is worth
 * maintaining. Switching language keeps working with JavaScript disabled,
 * middle-click and cmd-click open the other language in a new tab, and the
 * browser shows the destination on hover. A `<select>` can do none of those.
 */

/*
 * The path maths stays Starlight's. `localizedUrl` is exactly what its own
 * picker calls, and it is the part that knows about `base` — it strips
 * /ag-ui-rust off the front, swaps the locale segment, and puts the base back —
 * as well as about `trailingSlash` and about `root` meaning "no prefix".
 * Reimplementing that here would be a second copy of a rule that lives in
 * astro.config.ts, and the two would drift.
 *
 * The import reaches into node_modules by path because there is no other way
 * in. Starlight's `exports` map covers `.`, `./locals`, `./components`,
 * `./components/*`, `./internal`, `./props`, `./schema`, `./loaders`,
 * `./route-data`, `./types`, `./expressive-code`, `./expressive-code/hast`,
 * `./routes/*` and `./style/markdown.css` — no `./utils/*` — so the bare
 * specifier does not resolve, and `./internal` re-exports only
 * `useTranslations` and `getStarlightEcConfigPreprocessor`. Checked, not
 * assumed.
 *
 * A relative specifier is what gets past that, because `exports` is consulted
 * only for bare ones; a path is just a path. It also carries no version:
 * website/node_modules/@astrojs/starlight is pnpm's symlink into the store, so
 * this line does not have to name 0.41.7 or a store hash and does not change
 * when either does.
 *
 * That is a real cost: a Starlight upgrade that moves or renames this file
 * breaks the build. It breaks it *loudly*, at build time, on a pull request —
 * the Pages workflow builds the site on every one. The alternative fails the
 * other way. A hand-written copy of the base, trailingSlash and root-locale
 * rules would keep compiling while quietly disagreeing with astro.config.ts,
 * and the first anyone would know is a 404 after a deploy. A loud break on
 * upgrade is the cheaper of the two.
 */
function localizedPathname(locale: string): string {
	return localizedUrl(Astro.url, locale, context.trailingSlash).pathname;
}

/*
 * `starlightRoute.locale` is documented as `undefined` for root-locale slugs,
 * and the key of the root locale in `config.locales` is by definition `root`,
 * so this is the comparison that marks English as current on an English page.
 * Starlight's own component compares against the raw `locale` and therefore
 * marks nothing at all on root-locale pages; a `<select>` hides that by falling
 * back to its first option, which happens to be the right one only because
 * `root` is listed first in astro.config.ts. A list of links has no such
 * fallback, so the comparison has to be correct.
 */
const currentLocale = Astro.locals.starlightRoute.locale ?? 'root';

const options = Object.entries(config.locales ?? {}).map(([locale, localeConfig]) => ({
	href: localizedPathname(locale),
	// Non-null as in Starlight's own component: the config schema requires
	// `label`, and `lang` is filled in from the locale key when omitted.
	label: localeConfig!.label,
	lang: localeConfig!.lang,
	current: locale === currentLocale,
}));
const current = options.find((option) => option.current);

const label = Astro.locals.t('languageSelect.accessibleLabel');
---

{
	config.isMultilingual && (
		<starlight-lang-select>
			{/*
			 * `<details>`/`<summary>` rather than a button with `aria-expanded` and
			 * a listbox: a listbox cannot open without JavaScript, which would
			 * strip the links back out of reach and undo the whole point of using
			 * links. A disclosure is open-able by the browser itself, so the
			 * no-JavaScript path is not a degraded one — it is the same links, one
			 * keypress away. `<summary>` is also focusable and Enter/Space-operable
			 * with nothing loaded, and it exposes `aria-expanded` natively.
			 */}
			<details data-picker>
				<summary>
					<span class="sr-only">{label}</span>
					<Icon name="translate" class="icon label-icon" />
					<span class="value">{current?.label}</span>
					<Icon name="down-caret" class="icon caret" />
				</summary>
				<ul class="panel">
					{options.map((option) => (
						<li>
							{/*
							 * `lang` makes a screen reader pronounce 한국어 with a Korean
							 * voice instead of spelling it out in English; `hreflang`
							 * says the same thing about the page on the other end.
							 */}
							<a
								class="option"
								data-picker-option
								href={option.href}
								hreflang={option.lang}
								lang={option.lang}
								aria-current={option.current ? 'true' : undefined}
							>
								<Icon name="approve-check" class="check" />
								<span>{option.label}</span>
							</a>
						</li>
					))}
				</ul>
			</details>
		</starlight-lang-select>
	)
}

<script>
	class StarlightLanguageSelect extends HTMLElement {
		constructor() {
			super();

			const details = this.querySelector('details');
			const summary = this.querySelector('summary');
			if (!details || !summary) return;

			const options = () => [...this.querySelectorAll<HTMLElement>('[data-picker-option]')];

			const close = (returnFocus: boolean) => {
				if (!details.open) return;
				details.open = false;
				if (returnFocus) summary.focus();
			};

			/*
			 * Two open panels overlapping each other looks broken, and the theme
			 * picker sits right next to this one in both the header and the mobile
			 * menu. The attribute rather than a class because Astro rewrites
			 * nothing about `data-picker` but a class name is shared ground.
			 */
			details.addEventListener('toggle', () => {
				if (!details.open) return;
				for (const other of document.querySelectorAll<HTMLDetailsElement>('details[data-picker]')) {
					if (other !== details) other.open = false;
				}
			});

			this.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') {
					close(true);
					return;
				}
				if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;

				const items = options();
				const index = items.indexOf(document.activeElement as HTMLElement);
				if (index === -1) {
					// Focus is on the summary rather than in the list: open the panel
					// and step into it, which is what a keyboard user pressing Down on
					// a collapsed picker is asking for.
					event.preventDefault();
					details.open = true;
					(event.key === 'ArrowDown' ? items[0] : items[items.length - 1])?.focus();
					return;
				}
				// Wrap in both directions. Adding `length - 1` is subtraction that
				// cannot go negative, so one modulo covers both keys.
				event.preventDefault();
				const step = event.key === 'ArrowDown' ? 1 : items.length - 1;
				items[(index + step) % items.length]?.focus();
			});

			// A click anywhere else closes the panel, without pulling focus back to
			// the summary — the user is already looking somewhere else.
			document.addEventListener('click', (event) => {
				if (!details.open) return;
				if (event.target instanceof Node && this.contains(event.target)) return;
				close(false);
			});

			/*
			 * Tabbing past the last option leaves the picker; the panel should not
			 * stay open behind the user. `relatedTarget` is null when focus goes
			 * nowhere at all (clicking dead space, switching windows) — the click
			 * handler above covers the first case and the second is not worth
			 * closing for.
			 */
			this.addEventListener('focusout', (event) => {
				const next = event.relatedTarget;
				if (next === null || (next instanceof Node && this.contains(next))) return;
				close(false);
			});
		}
	}

	customElements.define('starlight-lang-select', StarlightLanguageSelect);
</script>

<style>
	/*
	 * Deliberately unlayered. Starlight declares
	 * `starlight.base, starlight.reset, starlight.core, starlight.content,
	 * starlight.components, starlight.utils` in style/layers.css, and unlayered
	 * rules beat every one of them, so nothing here has to fight a specificity
	 * war with the styles that used to dress the `<select>`.
	 */

	details {
		position: relative;
	}

	summary {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.625rem 0.25rem;
		margin-inline: -0.25rem;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		user-select: none;
		/* Both halves are needed: `list-style` covers Firefox's `::marker` and
		   Chrome, the pseudo-element covers older Safari. */
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover,
	details[open] summary {
		color: var(--sl-color-white);
	}

	summary:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
		border-radius: 0.25rem;
	}

	.label-icon {
		font-size: 0.875rem;
	}

	.caret {
		font-size: 1.25rem;
		transition: transform 0.15s ease;
	}

	details[open] .caret {
		transform: rotate(180deg);
	}

	/*
	 * Fixed width, matching the `width="7em"` Starlight passed to its `<Select>`,
	 * so the header does not reflow when the label changes length between
	 * "English" and "한국어".
	 */
	.value {
		width: 7em;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.panel {
		position: absolute;
		z-index: 1;
		/*
		 * Anchored to the inline end because that is the edge that cannot move:
		 * this control is the last item in the header's right group and in the
		 * mobile menu footer, so a panel wider than its trigger has to grow
		 * inwards or it grows off-screen.
		 */
		inset-inline-end: 0;
		/*
		 * Mobile-first, and the direction is not cosmetic. Below 50rem this
		 * component only renders inside the mobile menu footer, which sits at the
		 * bottom of `.sidebar-pane` — and that pane is `overflow-y: auto`, which
		 * clips on both axes. A panel dropping downwards from there would be cut
		 * off by the bottom of the pane; upwards it stays inside the scroll box.
		 * Above 50rem the mobile menu is hidden (`md:sl-hidden` in Sidebar.astro)
		 * and only the header copy renders, where down is the only sensible way.
		 */
		inset-block-end: calc(100% + 0.5rem);
		min-width: 100%;
		max-width: min(16rem, calc(100vw - 2rem));
		margin: 0;
		padding: 0.25rem;
		list-style: none;
		background-color: var(--sl-color-bg-nav);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		box-shadow: var(--sl-shadow-md);
	}

	/* Fades in rather than sliding, because the panel opens upwards on mobile
	   and downwards on desktop and a single translate would be wrong in one. */
	@keyframes picker-panel-in {
		from {
			opacity: 0;
		}
	}

	details[open] .panel {
		animation: picker-panel-in 0.12s ease-out;
	}

	.option {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.375rem 0.5rem;
		border-radius: 0.25rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		text-decoration: none;
		white-space: nowrap;
	}

	/*
	 * The accent tint rather than a grey step, and that choice was made by
	 * looking at all four combinations rendered. A grey has to fork per theme —
	 * the panel is `--sl-color-bg-nav`, which is gray-6 in dark and gray-7 in
	 * light, so one step of separation is a different token in each — and in
	 * light it lands 1.08:1 against the panel, which is close to invisible.
	 * `--sl-color-accent-low` is one token for both, it is the same rust the
	 * sidebar's current page uses, and its warmth reads clearly against a cool
	 * grey panel even where the luminance difference is small.
	 */
	.option:hover {
		background-color: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}

	.option:focus-visible {
		/* Drawn inside so the ring is not clipped by the panel's own rounding. */
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: var(--sl-outline-offset-inside);
	}

	.option[aria-current='true'] {
		color: var(--sl-color-white);
		font-weight: 600;
	}

	/*
	 * The check is always in the DOM and only ever hidden, so every label starts
	 * at the same x position instead of shifting by the width of an icon.
	 */
	.check {
		font-size: 0.875rem;
		visibility: hidden;
		color: var(--sl-color-text-accent);
	}

	.option[aria-current='true'] .check {
		visibility: visible;
	}

	@media (min-width: 50rem) {
		summary {
			font-size: var(--sl-text-sm);
		}

		.panel {
			inset-block-end: auto;
			inset-block-start: calc(100% + 0.5rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.caret {
			transition: none;
		}

		details[open] .panel {
			animation: none;
		}
	}
</style>
